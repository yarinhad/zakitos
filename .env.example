# Shopify Storefront API — get these from your Shopify admin
# Admin > Apps > Develop apps > your app > API credentials

# Your Shopify store domain (e.g. zakitos.myshopify.com)
PUBLIC_STORE_DOMAIN=zakitos.myshopify.com

# Storefront API version
PUBLIC_STOREFRONT_API_VERSION=2024-01

# Public Storefront API access token (safe to expose in client)
PUBLIC_STOREFRONT_API_TOKEN=

# Private Storefront API access token (server-side only)
PRIVATE_STOREFRONT_API_TOKEN=

# Shopify Store ID (numeric, found in admin URL)
PUBLIC_STOREFRONT_ID=

# Session secret (random 32+ char string)
SESSION_SECRET=your-secret-here-change-me
